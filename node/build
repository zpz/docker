#!/usr/bin/bash

# This image is based on the zppz/ubuntu image built in ../ubuntu.

set -Eeuo pipefail


NAMESPACE=zppz
PARENT=$(minidocker find-local-image ${NAMESPACE}/ubuntu)
TAG=$(minidocker make-date-version)
NAME=${NAMESPACE}/node:${TAG}

echo "building $NAME ..."

docker build --progress=plain --no-cache \
    -t "${NAME}" \
    --build-arg PARENT=${PARENT} \
    --build-arg BUILDKIT_DOCKERFILE_CHECK=skip=InvalidDefaultArgInFrom \
    . \


